# Copy this file to ".env" and edit. NEVER commit ".env".
DATA_PROVIDER=yfinance
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CACHE_TTL_SECONDS=15

# Only needed later if you add the Upstox provider (backend only, never in the frontend)
UPSTOX_ACCESS_TOKEN=

HISTORY_CACHE_TTL_SECONDS=900
ALLOW_DEMO_FALLBACK=false